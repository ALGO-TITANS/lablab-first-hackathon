# Safe CSV Analyst & Self-Healing AI Code Execution Agent
# Root Environment Variables Configuration Template

# -----------------------------------------------------------------------------
# Deployment & Runtime Environment
# -----------------------------------------------------------------------------
# Options: "development", "production", "test"
ENVIRONMENT=production
# In production, DEBUG defaults to False unless explicitly set to True
DEBUG=False

# Public Portfolio Demonstration Mode & Execution Guard
# In production, arbitrary host code execution is disabled by default (ENABLE_ARBITRARY_EXECUTION=False)
# and demo mode is active (DEMO_MODE=True), protecting public instances while showcasing sample analytics and self-healing.
ENABLE_ARBITRARY_EXECUTION=false
DEMO_MODE=true

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard "*" is strictly rejected.
# Localhost origins (3000, 5173) are always retained for local development.
# In production on Render, set this to your Vercel frontend URL:
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# Persistent Storage Paths (Render / Cloud Disks)
# -----------------------------------------------------------------------------
# On Render with a Persistent Disk mounted at /var/data, set DATA_DIR=/var/data
# UPLOADS_DIR and DB_PATH will default to $DATA_DIR/uploads and $DATA_DIR/metadata.db
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
# DB_PATH=/var/data/metadata.db

# -----------------------------------------------------------------------------
# Backend AI Provider Configuration
# -----------------------------------------------------------------------------
# Default provider: "mock" (zero API cost, deterministic for hackathon grading),
# "gemini" (Google Gemini 2.0 Flash), or "openai" (OpenAI / Groq)
DEFAULT_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Backend Execution Sandbox Constraints
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
SANDBOX_TIMEOUT_SECONDS=8.0
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_OUTPUT_CHARS=200000
MAX_REPAIR_ATTEMPTS=2

# -----------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# -----------------------------------------------------------------------------
# Base URL for API requests.
# IMPORTANT: NEXT_PUBLIC_* variables are inlined into client-side JS bundles during build!
# They are visible in browser DevTools and network tabs. Never put secrets here.
# For local dev: http://localhost:8000
# For Vercel production: https://your-backend-app.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
