# Safe CSV Analyst & Self-Healing AI Execution Agent - Backend Config

# Deployment & Runtime Environment
ENVIRONMENT=production
DEBUG=False

# Public Demonstration Mode & Execution Guard
# In production, arbitrary host code execution is disabled by default (ENABLE_ARBITRARY_EXECUTION=False)
# and demo mode is active (DEMO_MODE=True), protecting public instances while showcasing sample analytics and self-healing.
ENABLE_ARBITRARY_EXECUTION=false
DEMO_MODE=true

# CORS Allowed Origins
# Comma-separated list of allowed origins. Wildcard "*" is strictly rejected.
# Localhost origins (3000, 5173) are always retained for development convenience.
CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000

# Persistent Storage Paths (Render / Cloud Disks)
# On Render with a Persistent Disk mounted at /var/data, set DATA_DIR=/var/data
# UPLOADS_DIR and DB_PATH default to $DATA_DIR/uploads and $DATA_DIR/metadata.db
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
# DB_PATH=/var/data/metadata.db

# AI Provider Configuration
# Options: "mock" (offline/zero-cost), "gemini", "openai"
DEFAULT_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Execution & Sandbox Limits
MAX_UPLOAD_SIZE_MB=50
SANDBOX_TIMEOUT_SECONDS=8.0
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_MAX_OUTPUT_CHARS=200000
MAX_REPAIR_ATTEMPTS=2
